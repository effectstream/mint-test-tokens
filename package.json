{
  "name": "@effectstream/mint-test-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run build && node packages/registry/dist/validate.js",
    "deploy:v1": "node --import tsx scripts/v1-deploy.ts deploy",
    "verify:v1": "node --import tsx scripts/v1-deploy.ts verify",
    "test:wallet:v1": "node --import tsx scripts/v1-mint-wallet-test.ts",
    "typecheck:tools": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck scripts/v1-deploy.ts scripts/v1-mint-wallet-test.ts scripts/lib/*.ts test/registry-*.test.ts test/receiver-v1-chain.ts test/receiver-v1-unshielded-chain.ts",
    "test:registry": "node --import tsx --test test/registry-semantic.test.ts test/registry-publisher.test.ts",
    "test:receiver:v1": "RECEIVER_PROFILE=v1 node test/receiver-runtime.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "pino": "10.3.1",
    "tsx": "4.20.6"
  },
  "overrides": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
